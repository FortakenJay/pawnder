# Copy to .env and fill in. .env is gitignored: never commit it.

# --- Nebius Token Factory (OpenAI-compatible) ---
# Key: https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Fast model for live in-game comments (Nemotron Super or Nano)
NEMOTRON_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
# Deep model for the post-game review (Nemotron Ultra)
NEMOTRON_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Model IDs change: `python -m coach models` lists the Nemotron models your key can use.

# --- Engine ---
# Empty = find stockfish on PATH / Homebrew
STOCKFISH_PATH=
ENGINE_TIME_S=0.4

# --- Coach ---
# Which side the coach starts on: white, black or both (switch it any time on the web page)
COACH_PLAYER=white
# Speak when a move loses at least this many centipawns
COACH_MISTAKE_CP=150
# Warn when the opponent threatens to win at least this much
COACH_THREAT_CP=250
COACH_DB=coach.db

# --- Optional (P2) ---
TAVILY_API_KEY=
